RewriteEngine On

RewriteRule ^login$ login.php [NC,L]
RewriteRule ^add_reason$ add_reason.php [NC,L]
RewriteRule ^add_reason$ add_reason.php [NC,L]
RewriteRule ^mark_paid$ mark_paid.php [NC,L]
RewriteRule ^pay_2024$ pay_2024.php [NC,L]
RewriteRule ^due_reports$ due_reports.php [NC,L]
RewriteRule ^reason_list$ reason_list.php [NC,L]
RewriteRule ^processing$ x.php [NC,L]
RewriteRule ^loans$ loans.php [NC,L]
RewriteRule ^send_email$ send_email.php [NC,L]
RewriteRule ^batch_photo_email$ batch_photo_email.php [NC,L]
RewriteRule ^batch_photo_demo$ batch_photo_demo.php [NC,L]

RewriteRule ^edit_user/(\d+)$ edit_user.php?id=$1 [NC,L]

Options -Indexes

ErrorDocument 404 ./404.html
